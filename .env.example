# Copy to .env for `make run` / `make migrate`. Never commit .env.
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5434/billing?sslmode=disable
HTTP_ADDR=:8080
# Browser-facing base URL; builds mock checkout links.
PUBLIC_URL=http://localhost:8080
# Platform admin key(s) from the environment. Use one to create the first
# tenant, then prefer database keys (`billing keys create --platform`).
BOOTSTRAP_API_KEYS=change-me-local-platform-key
# Encrypts payment-provider credentials at rest. Required in production;
# back it up with your database password. Generate: openssl rand -hex 32
SECRETS_KEY=
# 32+ characters; encrypts the UI session cookie.
UI_COOKIE_KEY=change-me-to-32-or-more-random-characters
# Run the billing engine + webhook dispatcher inside `serve`.
WORKER_ENABLED=true
WORKER_INTERVAL=30s
# Let webhooks reach localhost/private networks. Development only: with it on,
# any tenant can make the server call internal services.
WEBHOOK_ALLOW_PRIVATE=true
LOG_LEVEL=info
LOG_JSON=false
